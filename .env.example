# Runtime database connection for the Game schema.
GAME_DATABASE_URL=

# RS256 verification configuration shared with AuthUser.
JWT_PUBLIC_KEY=
JWT_ISSUER=
JWT_AUDIENCE=

# AuthUser base URL without the /v1 suffix.
AUTHUSER_URL=

# Optional exact browser origins, comma-separated.
CORS_ALLOWED_ORIGINS=
PORT=

# Migration-only direct connection; provide privately only for Prisma commands.
GAME_DATABASE_DIRECT_URL=
