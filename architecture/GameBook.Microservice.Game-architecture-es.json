  "cards": [
    {
      "dot": "rose",
      "title": "Límite de confianza",
      "items": [
        "Game verifica RS256 localmente y luego solicita a AuthUser validar la sesión vigente.",
        "Si AuthUser no está disponible, la solicitud falla de forma segura con HTTP 503.",
        "El subject del JWT autenticado delimita todas las operaciones de favoritos."
      ]
    },
    {
      "dot": "emerald",
      "title": "Persistencia y despliegue",
      "items": [
        "El acceso Prisma de runtime usa el esquema game y el rol de base de datos de runtime.",
        "Las migraciones de Game desplegadas se ejecutan en GitHub Actions controlado; sus credenciales no se configuran en Render.",
        "Los metadatos de Swagger se componen con decoradores reutilizables por endpoint."
      ]
    }
  ]
