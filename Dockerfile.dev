FROM node:24-alpine

WORKDIR /app

RUN corepack enable && corepack prepare pnpm@12.4.1 --activate

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile

COPY . .

ENV NODE_ENV=development

EXPOSE 3002

# Prisma generation needs only a syntactically valid direct URL; it never connects
# and Compose never receives the migration credential.
CMD ["sh", "-c", "GAME_DATABASE_DIRECT_URL=postgresql://compose:compose@127.0.0.1:5432/compose pnpm db:generate && pnpm start:dev"]
